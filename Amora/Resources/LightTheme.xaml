<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Farben -->
    <Color x:Key="BackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="ForegroundColor">#FF000000</Color>
    <Color x:Key="InputBackgroundColor">#FFFAFAFA</Color>
    <Color x:Key="BorderColor">#FFCCCCCC</Color>
    <Color x:Key="PrimaryColor">#f44336</Color>
    <Color x:Key="SecondaryColor">#ff9100</Color>

    <!-- Fensterhintergrundfarbe -->
    <Color x:Key="WindowBackgroundColor">#FFF6F6F6</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource BackgroundColor}" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="{DynamicResource ForegroundColor}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{DynamicResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource PrimaryColor}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{DynamicResource SecondaryColor}" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource WindowBackgroundColor}" />

    <!-- PlaceHolder Brush -->
    <SolidColorBrush x:Key="PlaceholderBrush" Color="Gray"/>


</ResourceDictionary>

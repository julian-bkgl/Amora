<Window x:Class="Amora.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Icon="/Assets/heart_logo.ico"
        Background="Transparent"
        Title="Amora"
        Height="700"
        Width="900"
        UseLayoutRounding="True">

    <Border CornerRadius="21"
            Background="{DynamicResource WindowBackgroundBrush}"

            BorderThickness="1"
            ClipToBounds="True"
            SnapsToDevicePixels="True">
        <!--BorderBrush="{DynamicResource SecondaryBrush}"-->

        <!-- kleiner Innenabstand simuliert visuellen Abstand zum Rand -->
        <Grid Margin="2" UseLayoutRounding="True">

            <Border CornerRadius="18"
                    Background="{DynamicResource BackgroundBrush}"
                    SnapsToDevicePixels="True"
                    ClipToBounds="True">

                <Grid>
                    <!-- Fensterleiste -->
                    <Border Background="{DynamicResource BackgroundBrush}"
                            Height="40"
                            VerticalAlignment="Top"
                            CornerRadius="14,14,0,0"
                            ClipToBounds="True"
                            MouseDown="TitleBar_MouseDown" Margin="5,0,5,0">

                        <Grid Cursor="">
                            <Image Source="/Assets/heart_logo.png"
                                   Width="31"
                                   Height="40"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="10,0,0,0"/>

                            <TextBlock Text="Amora"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       VerticalAlignment="Center"
                                       Margin="40,0,0,0"
                                       FontWeight="SemiBold"
                                       FontSize="16"
                                       HorizontalAlignment="Left"/>


                            <Grid HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,0,10,0"
                                Height="35"
                                Width="115"
                                ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                    Content="—"
                                    Click="Minimize_Click"
                                    Width="35"
                                    Height="35"
                                    Background="Transparent"
                                    Foreground="{DynamicResource ForegroundBrush}"
                                    BorderThickness="0"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Margin="0,0,5,0"/>

                                <Button Grid.Column="1"
                                    x:Name="ThemeSwitchButton"
                                    Content="🌙"
                                    Click="ToggleTheme_Click"
                                    Width="35"
                                    Height="35"
                                    Background="Transparent"
                                    Foreground="{DynamicResource ForegroundBrush}"
                                    BorderThickness="0"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Margin="0,0,5,0"/>

                                <Button Grid.Column="2"
                                    Content="✕"
                                    Click="Close_Click"
                                    Width="35"
                                    Height="35"
                                    Background="Transparent"
                                    Foreground="{DynamicResource ForegroundBrush}"
                                    BorderThickness="0"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Cursor="Hand"/>
                            </Grid>


                        </Grid>
                    </Border>

                    <!-- Inhalt/MainFrame wo alles wichtig passiert! -->
                    <Frame x:Name="MainFrame"
                           NavigationUIVisibility="Hidden"
                           Margin="10,40,10,10"
                           Background="{DynamicResource BackgroundBrush}" />
                </Grid>
            </Border>
        </Grid>
    </Border>

</Window>

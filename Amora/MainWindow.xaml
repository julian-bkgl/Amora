<Window x:Class="Amora.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Icon="/Assets/heart_logo.ico"
        Background="Transparent"
        Title="Amora"
        Height="484"
        Width="791"
        UseLayoutRounding="True">

    <Window.Resources>
        <DropShadowEffect x:Key="WindowDropShadow"
                          BlurRadius="20"
                          ShadowDepth="0"
                          Opacity="0.35"
                          Color="Black"/>
    </Window.Resources>

    
    <Border CornerRadius="20"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource SecondaryBrush}"  
            BorderThickness="2"
            Effect="{StaticResource WindowDropShadow}"
            SnapsToDevicePixels="True">

        <!-- kleiner Innenabstand simuliert visuellen Abstand zum Rand -->
        <Grid Margin="3" UseLayoutRounding="True">

            <Border CornerRadius="16"
                    Background="{DynamicResource BackgroundBrush}"
                    SnapsToDevicePixels="True"
                    ClipToBounds="True">

                <Grid>
                    <!-- Fensterleiste -->
                    <Border Background="{DynamicResource BackgroundBrush}"
                            Height="40"
                            VerticalAlignment="Top"
                            CornerRadius="14,14,0,0"
                            MouseDown="TitleBar_MouseDown" Margin="5,0,5,0">

                        <Grid>
                            <Image Source="/Assets/heart_logo.png"
                                   Width="31"
                                   Height="40"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="10,0,0,0"/>

                            <TextBlock Text="Amora"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       VerticalAlignment="Center"
                                       Margin="40,0,0,0"
                                       FontWeight="SemiBold"
                                       FontSize="16"
                                       HorizontalAlignment="Left"/>

                            <!-- Buttons -->
                            <Button Content="—"
                                    Click="Minimize_Click"
                                    Width="40"
                                    Height="40"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,0,80,0"
                                    Background="Transparent"
                                    Foreground="{DynamicResource ForegroundBrush}"
                                    BorderThickness="0"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Cursor="Hand"/>

                            <Button x:Name="ThemeSwitchButton"
                                    Content="🌙"
                                    Click="ToggleTheme_Click"
                                    Width="40"
                                    Height="40"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,0,40,0"
                                    Background="Transparent"
                                    Foreground="{DynamicResource ForegroundBrush}"
                                    BorderThickness="0"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Cursor="Hand"/>

                            <Button Content="✕"
                                    Click="Close_Click"
                                    Width="40"
                                    Height="40"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    Foreground="{DynamicResource ForegroundBrush}"
                                    BorderThickness="0"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Inhalt/MainFrame wo alles wichtig passiert! -->
                    <Frame x:Name="MainFrame"
                           NavigationUIVisibility="Hidden"
                           Margin="10,40,10,10"
                           Background="{DynamicResource BackgroundBrush}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

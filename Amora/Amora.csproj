<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Data\**" />
    <EmbeddedResource Remove="Data\**" />
    <None Remove="Data\**" />
    <Page Remove="Data\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\heart_logo.ico" />
    <None Remove="Assets\heart_logo.png" />
  </ItemGroup>

  <ItemGroup>
    <Page Remove="Resources\DarkTheme.xaml" />
    <Page Remove="Resources\LightTheme.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySql.Data" Version="9.5.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\heart_logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\heart_logo.png" />
    <Resource Include="Resources\DarkTheme.xaml" />
    <Resource Include="Resources\LightTheme.xaml" />
  </ItemGroup>

</Project>

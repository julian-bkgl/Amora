<Page x:Class="Amora.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Amora.Pages"
      xmlns:res="clr-namespace:Amora.Resources"
      
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage"
      Background="{DynamicResource BackgroundBrush}">

    <Page.Resources> <!-- Lokales Laden der Styles.xaml ( ist damit Statische Resource ) --> 
        <ResourceDictionary Source="/Resources/Styles.xaml"/>
    </Page.Resources>
    
    <Grid>
        <Border Width="300" Padding="20" Background="{DynamicResource BackgroundBrush}" CornerRadius="15" 
                HorizontalAlignment="Center" VerticalAlignment="Center" 
                Effect="{DynamicResource DropShadow}">
            <StackPanel>
                <TextBlock Text="Anmeldung" FontSize="24" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,20"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                
                <TextBlock Text="Benutzernamen und Passwort eingeben" FontSize="12" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,20"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                
                <TextBox x:Name="UsernameTextBox"
                         Style="{StaticResource RoundedTextBox}"
                         res:PlaceHolderService.Placeholder="Benutzername/E-Mail"
                         Margin="0,0,0,20" Height="35"/>

                <PasswordBox x:Name="PasswordBox"
                             Style="{StaticResource RoundedPasswordBox}"
                             res:PlaceHolderService.Placeholder="Passwort"
                             Margin="0,0,0,20" Height="35"
                             KeyDown="Input_KeyDown"/>

                <Button Content="Einloggen/Registrieren"
                        Style="{StaticResource RoundedButton}"
                        Click="LoginButton_Click"/>
            </StackPanel>
            
        </Border>
        
    </Grid>
</Page>

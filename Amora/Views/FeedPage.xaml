<Page x:Class="Amora.Views.FeedPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      xmlns:res="clr-namespace:Amora.Resources"
      d:DesignHeight="800" d:DesignWidth="800"
      Background="{x:Null}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="RoundedButtonRed" TargetType="Button" BasedOn="{StaticResource RoundedButton}"> <!-- Button mit Rotem Hintergrund auf grundlage der Styles.xaml -->
                <Setter Property="Background" Value="OrangeRed"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border x:Name="UserCard" Width="400" Padding="20" Background="{DynamicResource BackgroundBrush}" CornerRadius="15"
                Effect="{StaticResource DropShadow}">
            <StackPanel>
                <!-- Profilbild -->
                <Image x:Name="ProfileImage" Width="150" Height="150" Margin="0,0,0,15" HorizontalAlignment="Center" Stretch="UniformToFill"/>

                <!-- Username -->
                <TextBlock x:Name="UsernameText" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,10"/>

                <!-- Bio -->
                <TextBlock x:Name="BioText" FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Center"
                           Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,20"/>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="DislikeButton" Content="👎" Style="{StaticResource RoundedButtonRed}" Width="60" Height="60" Click="Dislike_Click"/>
                    <Button Content="" Width="60" Height="60" Visibility="Hidden"/> <!-- Damit eine Lücke entsteht -->
                    <Button x:Name="LikeButton" Content="❤️" Style="{StaticResource RoundedButton}" Width="60" Height="60" Click="Like_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

</Page>
<Page x:Class="Amora.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Amora.Views"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="800"
      Title="HomePage"
      >

    <Page.Resources>
        <ResourceDictionary Source="/Resources/Styles.xaml"/>
    </Page.Resources>

    <Grid>
        <!-- Hauptcontainer -->
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <!-- Obere Leiste -->
            <RowDefinition Height="*"/>
            <!-- Feed-Bereich -->
        </Grid.RowDefinitions>


        <!-- Obere Leiste -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- Links -->
                <ColumnDefinition Width="*"/>
                <!-- Mitte -->
                <ColumnDefinition Width="Auto"/>
                <!-- Rechts -->
            </Grid.ColumnDefinitions>

            <!-- Links: ❤️ und ⭐ -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button Content="❤️" Style="{StaticResource RoundedButton}" Width="40" Height="40" Margin="5" Click="Like_Click"/>
                <Button Content="🌟" Style="{StaticResource RoundedButton}" Width="40" Height="40" Margin="5" Click="Matches_Click"/>
            </StackPanel>

            <!-- Mitte: Zurück zum Feed -->
            <Button Grid.Column="1" Content="🏠" Style="{StaticResource RoundedButton}" Width="40" Height="40" Margin="5"
            HorizontalAlignment="Center" VerticalAlignment="Center" Click="GoToFeed_Click"/>

            <!-- Rechts: 🖊️ -->
            <Button Grid.Column="2" Content="🖊️" Style="{StaticResource RoundedButton}" Width="40" Height="40" Margin="5"
            HorizontalAlignment="Right" VerticalAlignment="Center" Click="EditProfile_Click"/>
        </Grid>

        <Frame x:Name="ContentFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Background="{x:Null}"/>
    </Grid>
</Page>

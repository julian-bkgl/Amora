<Page x:Class="Amora.Views.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Amora.Views"
      xmlns:res="clr-namespace:Amora.Resources"

      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="800"
      Title="RegisterPage"
      Background="{DynamicResource BackgroundBrush}">

    <Page.Resources>
        <!-- Lokales Laden der Styles.xaml ( ist damit Statische Resource ) -->
        <ResourceDictionary Source="/Resources/Styles.xaml"/>
    </Page.Resources>

    <Grid>
        <Border Width="400" Padding="20" Background="{DynamicResource BackgroundBrush}" CornerRadius="15" 
                HorizontalAlignment="Center" VerticalAlignment="Center" 
                Effect="{StaticResource DropShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Titel -->
                    <TextBlock Text="Registrierung" FontSize="24" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="0,0,0,20"
                               Foreground="{DynamicResource ForegroundBrush}"/>

                    <TextBlock Text="Bitte füllen Sie alle Felder aus" FontSize="12" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="0,0,0,20"
                               Foreground="{DynamicResource ForegroundBrush}"/>

                    <!-- Benutzername -->
                    <TextBox x:Name="UsernameTextBox"
                             Style="{StaticResource RoundedTextBox}"
                             res:PlaceHolderService.Placeholder="Benutzername"
                             Margin="0,0,0,15" Height="35"/>

                    <!-- E-Mail -->
                    <TextBox x:Name="EmailTextBox"
                             Style="{StaticResource RoundedTextBox}"
                             res:PlaceHolderService.Placeholder="E-Mail"
                             Margin="0,0,0,15" Height="35"/>

                    <!-- Passwort -->
                    <PasswordBox x:Name="PasswordBox"
                                 Style="{StaticResource RoundedPasswordBox}"
                                 res:PlaceHolderService.Placeholder="Passwort"
                                 Margin="0,0,0,15" Height="35"/>

                    <!-- Passwort bestätigen -->
                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 Style="{StaticResource RoundedPasswordBox}"
                                 res:PlaceHolderService.Placeholder="Passwort bestätigen"
                                 Margin="0,0,0,15" Height="35"/>

                    <!-- Geschlecht -->
                    <StackPanel Margin="0,0,0,15">
                        <Grid x:Name="GenderPanel" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <RadioButton Grid.Column="0"
                                 Content="Männlich"
                                 GroupName="GenderGroup"
                                 Style="{StaticResource GenderSwitchButtonStyle}"
                                 Tag="Männlich"
                                 HorizontalAlignment="Stretch" />

                            <RadioButton Grid.Column="1"
                                 Content="Weiblich"
                                 GroupName="GenderGroup"
                                 Style="{StaticResource GenderSwitchButtonStyle}"
                                 Tag="Weiblich"
                                 HorizontalAlignment="Stretch" />

                            <RadioButton Grid.Column="2"
                                 Content="Divers"
                                 GroupName="GenderGroup"
                                 Style="{StaticResource GenderSwitchButtonStyle}"
                                 Tag="Divers"
                                 HorizontalAlignment="Stretch" />
                        </Grid>
                    </StackPanel>

                    <!-- Geburtsdatum -->
                    <DatePicker x:Name="BirthDatePicker"
                                Style="{StaticResource RoundedDatePicker}"
                                Margin="0,0,0,15" Height="35"
                                Foreground="{DynamicResource ForegroundBrush}"
                                Background="{DynamicResource InputBackgroundBrush}"/>

                    <!-- Standort -->
                    <TextBox x:Name="LocationTextBox"
                             Style="{StaticResource RoundedTextBox}"
                             res:PlaceHolderService.Placeholder="Standort"
                             Margin="0,0,0,15" Height="35"/>

                    <!-- Bio -->
                    <TextBox x:Name="BioTextBox"
                             Style="{StaticResource RoundedTextBox}"
                             res:PlaceHolderService.Placeholder="Kurzbeschreibung"
                             Margin="0,0,0,15" Height="70"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"/>

                    <!-- Profilbild -->
                    <Button Content="Profilbild hochladen"
                            Style="{StaticResource RoundedButton}"
                            Margin="0,0,0,25"
                            Click="UploadProfilePicture_Click"/>

                    <!-- Registrieren Button -->
                    <Button Content="Registrieren"
                            Style="{StaticResource RoundedButton}"
                            Click="RegisterButton_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>

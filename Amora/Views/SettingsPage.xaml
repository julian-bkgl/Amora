<Page x:Class="Amora.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Amora.Views"
      xmlns:res="clr-namespace:Amora.Resources"
      mc:Ignorable="d" d:DesignWidth="800"
      Title="SettingsPage" Height="575">


    <Page.Resources>
        <ResourceDictionary Source="/Resources/Styles.xaml"/>
    </Page.Resources>

    <Grid>
        <Border Width="400" Padding="20" Background="{DynamicResource BackgroundBrush}" CornerRadius="15"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Effect="{StaticResource DropShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Titel -->
                    <TextBlock Text="Einstellungen" FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,20"
                               Foreground="{DynamicResource ForegroundBrush}"/>

                    <!-- Untertitel -->
                    <TextBlock Text="Passe deine App-Einstellungen an" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,20"
                               Foreground="{DynamicResource ForegroundBrush}"/>

                    <!-- Benutzername ändern -->
                    <TextBox x:Name="UsernameTextBox"
                             Style="{StaticResource RoundedTextBox}"
                             res:PlaceHolderService.Placeholder="Neuer Benutzername"
                             Margin="0,0,0,15" Height="35"/>

                    <!-- E-Mail ändern -->
                    <TextBox x:Name="EmailTextBox"
                             Style="{StaticResource RoundedTextBox}"
                             res:PlaceHolderService.Placeholder="Neue E-Mail"
                             Margin="0,0,0,15" Height="35"/>

                    <!-- Passwort ändern -->
                    <PasswordBox x:Name="NewPasswordBox"
                                 Style="{StaticResource RoundedPasswordBox}"
                                 res:PlaceHolderService.Placeholder="Neues Passwort"
                                 Margin="0,0,0,15" Height="35"/>

                    <!-- Passwort bestätigen -->
                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 Style="{StaticResource RoundedPasswordBox}"
                                 res:PlaceHolderService.Placeholder="Passwort bestätigen"
                                 Margin="0,0,0,15" Height="35"/>

                    <!-- Standort -->
                    <TextBox x:Name="LocationTextBox"
                             Style="{StaticResource RoundedTextBox}"
                             res:PlaceHolderService.Placeholder="Standort"
                             Margin="0,0,0,15" Height="35"/>

                    <!-- Bio -->
                    <TextBox x:Name="BioTextBox"
                             Style="{StaticResource RoundedTextBox}"
                             res:PlaceHolderService.Placeholder="Kurzbeschreibung"
                             Margin="0,0,0,15" Height="70"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"/>

                    <!-- Profilbild ändern -->
                    <Button Content="Profilbild ändern"
                            Style="{StaticResource RoundedButton}"
                            Margin="0,0,0,25"
                            Click="ChangeProfilePicture_Click"/>

                    <!-- Speichern Button -->
                    <Button Content="Speichern"
                            Style="{StaticResource RoundedButton}"
                            Click="SaveSettings_Click"/>
                </StackPanel>
                
            </ScrollViewer>
        </Border>
    </Grid>

</Page>

<Page x:Class="Amora.Views.MatchesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Amora.Views"
      xmlns:res="clr-namespace:Amora.Resources"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MatchesPage">

    <Page.Resources>
        <ResourceDictionary Source="/Resources/Styles.xaml"/>
    </Page.Resources>

    <Grid Margin="20">
        <!-- Titel -->
        <TextBlock Text="Deine Matches"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,10"
                   Foreground="{DynamicResource ForegroundBrush}"/>


        <!-- Suchfeld -->
        <TextBox x:Name="SearchBox"
             Margin="0,0,0,10"
             Height="30"
             Width="300"
             VerticalAlignment="Top"
             Style="{StaticResource RoundedTextBox}"
             res:PlaceHolderService.Placeholder="Suche nach Username oder Bio..."
             TextChanged="SearchBox_TextChanged"
             Background="{DynamicResource InputBackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}"
             BorderBrush="{DynamicResource BorderBrush}"
             />

        <!-- Matches in einem WrapPanel -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,40,0,0">
            <ItemsControl ItemsSource="{Binding Matches}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10" Margin="10" CornerRadius="8"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Grid Width="300">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Profilbild -->
                                <Image Width="100" Height="100" Margin="0,0,10,0"
                                       Stretch="UniformToFill" ClipToBounds="True"
                                       Source="{Binding ProfilePictureUrl}"/>

                                <!-- Username und Bio -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Username}" FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text="{Binding Bio}" FontSize="14"
                                               Foreground="{DynamicResource PlaceholderBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
